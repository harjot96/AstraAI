// Copy to Secrets.xcconfig (git-ignored). The app never holds an Anthropic key:
// it talks to the AstraAI proxy in /server, which does.
// In xcconfig "//" starts a comment, so URLs are written as http:/$()/host
CLAUDE_BASE_URL = http:/$()/localhost:8787
ASTRA_APP_TOKEN = devtoken
// RevenueCat public SDK key (starts with appl_ or test_). Project settings › API keys.
// Leave empty to run the app fully free (no paywall).
REVENUECAT_API_KEY =
