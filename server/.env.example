# Copy to .env (git-ignored) and fill in. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Must match ASTRA_APP_TOKEN in Config/Secrets.xcconfig
APP_TOKEN=devtoken
# Optional: RevenueCat secret API key (sk_...). When set, only Pro subscribers get Claude.
REVENUECAT_SECRET_KEY=
